{
  "mavlink": {
    "connection": "udpin:127.0.0.1:14550",
    "baud": 921600,
    "heartbeat_timeout_s": 2.5,
    "rate_retry_interval_s": 10,
    "message_rates_hz": {
      "ATTITUDE": 30,
      "LOCAL_POSITION_NED": 30,
      "GLOBAL_POSITION_INT": 20,
      "GPS_RAW_INT": 10,
      "VFR_HUD": 10,
      "SYS_STATUS": 5,
      "MISSION_CURRENT": 5,
      "DISTANCE_SENSOR": 20
    },
    "freshness_s": {
      "HEARTBEAT": 2.5,
      "ATTITUDE": 0.1,
      "LOCAL_POSITION_NED": 0.15,
      "GLOBAL_POSITION_INT": 0.3,
      "GPS_RAW_INT": 0.5,
      "VFR_HUD": 0.3,
      "SYS_STATUS": 1,
      "MISSION_CURRENT": 1,
      "DISTANCE_SENSOR": 0.2
    },
    "source_system": 1,
    "source_component": 191,
    "target_system": 1,
    "target_component": 1,
    "vct": {
      "ack_timeout_s": 0.8,
      "state_timeout_s": 1.5,
      "max_attempts": 3,
      "backoff_s": [
        0.25,
        0.5,
        0.9
      ],
      "mode_settle_s": 0.35,
      "mode_roundtrip_pause_s": 0.75,
      "arm_terminal_reject_results": [
        1,
        2,
        3,
        4,
        6,
        7,
        8,
        9
      ],
      "disarm_terminal_reject_results": [
        1,
        2,
        3,
        4,
        6,
        7,
        8,
        9
      ],
      "capture_statustext": true
    },
    "transport": "MAVPROXY_UDP",
    "device": "127.0.0.1:14550",
    "note": "MAVProxy is the sole /dev/ttyAMA0 owner. main.py receives/sends MAVLink through localhost UDP 14550."
  },
  "mission_planner_gateway": {
    "enabled": false,
    "bind_ip": "0.0.0.0",
    "port": 14555,
    "destination_port": 14555,
    "destination_ip": "AUTO_GCS",
    "policy": "MAVPROXY_DIRECT",
    "learn_peer": true,
    "strict_inbound_source": true,
    "mirror_queue_size": 512,
    "note": "Disabled in FULL_MISSION: Mission Planner/RTK uses the proven direct MAVProxy output path; main.py does not relay RTCM."
  },
  "rates_hz": {
    "mission": 50,
    "movement": 50,
    "gcs_telemetry": 10,
    "health": 1,
    "vehicle_monitor": 2
  },
  "stream": {
    "front_video_port": 14560,
    "front_metadata_port": 14561,
    "control_port": 14562,
    "bottom_video_port": 14563,
    "bottom_metadata_port": 14564,
    "backend": "ffmpeg",
    "destination_ip": "127.0.0.1",
    "width": 640,
    "height": 400,
    "fps": 20,
    "front_bitrate_kbps": 2000,
    "bottom_bitrate_kbps": 1700,
    "keyint": 20,
    "metadata_hz": 20,
    "video_transport": "MPEG-TS/H264/UDP",
    "sync": "48-cell barcode exact frame_id",
    "start_on_hello": true,
    "source_geometry": [
      1920,
      1200
    ],
    "display_geometry": [
      640,
      400
    ],
    "display_policy": "WIDE_NATIVE",
    "profile": "FIELD_LIGHT_20FPS",
    "note_geometry": "Native 640x400 downlink retained; V2.3 reduces frame rate and bitrate before sacrificing operator resolution."
  },
  "camera": {
    "backend": "picamera2",
    "front": {
      "camera_num": 1,
      "role": "FRONT",
      "sensor_mode": {
        "width": 1920,
        "height": 1200,
        "fps": 60,
        "bit_depth": 10
      },
      "output": {
        "width": 1920,
        "height": 1200,
        "format": "RGB888",
        "preserve_aspect": true,
        "array_color_order": "BGR"
      },
      "ai_state": "STANDBY",
      "ai_task": "GATE_NAV"
    },
    "bottom": {
      "camera_num": 0,
      "role": "BOTTOM",
      "sensor_mode": {
        "width": 1920,
        "height": 1200,
        "fps": 60,
        "bit_depth": 10
      },
      "output": {
        "width": 1920,
        "height": 1200,
        "format": "RGB888",
        "preserve_aspect": true,
        "array_color_order": "BGR"
      },
      "ai_state": "STANDBY",
      "ai_task": "DROP_ALIGNMENT"
    },
    "runtime": {
      "capture_target_fps": 30,
      "stream_consumer_fps": 20,
      "latest_frame_policy": true,
      "queue": false,
      "buffer_count": 3,
      "warmup_s": 0.5,
      "color_conversion": "NONE",
      "canonical_width": 1920,
      "canonical_height": 1200,
      "geometry_policy": "FULL_SENSOR_WIDE_LIGHTWEIGHT",
      "thermal_policy": "30FPS_CAPTURE_20FPS_FIELD_STREAM"
    },
    "legacy_file_fallback": {
      "enabled": false,
      "front_source": "Gate6.mp4",
      "bottom_source": "Gate6.mp4",
      "loop_file_sources": true
    }
  },
  "version": "3.0.0-full-mission",
  "rangefinder": {
    "enabled": true,
    "sensor_model": "Benewake TFmini Plus",
    "physical_interface": "I2C_to_FC",
    "preferred_mavlink_message": "DISTANCE_SENSOR",
    "fallback_mavlink_message": "RANGEFINDER",
    "expected_orientation": 25,
    "expected_orientation_name": "MAV_SENSOR_ROTATION_PITCH_270",
    "preferred_for_low_altitude": true,
    "valid_age_s": 0.2,
    "allow_legacy_fallback": true
  },
  "vision_branch": {
    "enabled": true,
    "flight_movement_enabled": true,
    "architecture": "YOLO26_BBOX_LIGHTWEIGHT"
  },
  "ai": {
    "enabled": true,
    "engine": "YOLO26_ONLY",
    "model_size": 640,
    "detector": {
      "hef": "models/hailo8/yolo26_gate_v2.hef",
      "confidence_threshold": 0.25,
      "iou_threshold": 0.45
    },
    "front": {
      "task": "GATE_NAV",
      "detector_class_id": 1
    },
    "bottom": {
      "task": "DROP_ALIGNMENT",
      "detector_class_id": 0
    },
    "route": {
      "camera": "none",
      "model_mode": "OFF",
      "task": "NONE",
      "detector_class_id": null,
      "source": "FULL_MISSION_STARTUP"
    },
    "model_modes": [
      "OFF",
      "YOLO26_ONLY"
    ],
    "test_switch": {
      "enabled": false,
      "loop": true,
      "sequence": [
        {
          "duration_s": 5,
          "camera": "front",
          "model_mode": "YOLO26_ONLY",
          "task": "GATE_NAV",
          "detector_class_id": 1
        },
        {
          "duration_s": 5,
          "camera": "bottom",
          "model_mode": "YOLO26_ONLY",
          "task": "DROP_ALIGNMENT",
          "detector_class_id": 0
        }
      ]
    },
    "input_geometry": {
      "source_width": 1920,
      "source_height": 1200,
      "model_width": 640,
      "model_height": 640,
      "resize_policy": "LETTERBOX",
      "scale": 0.3333333333333333,
      "resized_width": 640,
      "resized_height": 400,
      "pad_left": 0,
      "pad_right": 0,
      "pad_top": 120,
      "pad_bottom": 120,
      "output_coordinates": "CANONICAL_1920x1200"
    }
  },
  "run_mode": {
    "profile": "FULL_MISSION",
    "available_profiles": [
      "VISION_STREAM_TEST",
      "VISION_AI_TEST",
      "MOVEMENT_TEST",
      "FULL_MISSION"
    ],
    "watermark": {
      "enabled_in_test": true,
      "hide_in_full_mission": true,
      "position": "TOP_CENTER",
      "text_by_profile": {
        "VISION_STREAM_TEST": "TEST MODE - VISION STREAM",
        "VISION_AI_TEST": "TEST MODE - VISION + AI",
        "MOVEMENT_TEST": "TEST MODE - MOVEMENT",
        "FULL_MISSION": ""
      }
    }
  },
  "vision_pose": {
    "enabled": false,
    "flight_dependency": false,
    "note": "Research/debug only; not loaded by V2 normal runtime."
  },
  "vision_color": {
    "canonical_internal_order": "BGR",
    "camera_backend": "picamera2",
    "picamera2_main_format": "RGB888",
    "picamera2_array_observed_order": "BGR",
    "camera_conversion": "NONE",
    "opencv_order": "BGR",
    "ffmpeg_input_pix_fmt": "bgr24",
    "hailo_tensor_order": "RGB",
    "hailo_conversion": "BGR_TO_RGB_ONCE",
    "validated_on": "2026-08-20",
    "validation": "Real AR0234 bench test: removing CameraManager RGB/BGR conversion restored correct visible colors. Keep the captured NumPy frame as canonical BGR for OpenCV/streaming, and convert exactly once at Hailo preprocessing."
  },
  "vision_control": {
    "enabled": true,
    "movement_tx_enabled": false,
    "coordinate_space": "CANONICAL_1920x1200",
    "freshness_s": 0.15,
    "confidence_min": 0.25,
    "deadband_x": 0.035,
    "deadband_y": 0.035,
    "front": {
      "kp_lateral": 1.2,
      "kp_yaw_rate": 20,
      "max_lateral_mps": 1.5,
      "max_yaw_rate_dps": 25,
      "forward_max_mps": 5,
      "forward_min_mps": 1.2,
      "slow_area_ratio": 0.08,
      "commit_area_ratio": 0.22,
      "align_error_max": 0.12,
      "altitude_source": "RANGEFINDER"
    },
    "bottom": {
      "kp_xy": 1,
      "max_xy_mps": 1,
      "center_error_max": 0.05,
      "center_hold_frames": 5,
      "altitude_source": "RANGEFINDER"
    },
    "note": "Estimator only. Publishes intent to SharedState; sends no MAVLink movement."
  },
  "pi_health": {
    "temp_warn_c": 75,
    "temp_fail_c": 80,
    "cpu_warn_pct": 85,
    "cpu_fail_pct": 95,
    "ram_warn_pct": 85,
    "ram_fail_pct": 95,
    "disk_warn_free_gb": 2,
    "disk_fail_free_gb": 0.5,
    "disk_path": "/",
    "vcgencmd_timeout_s": 0.35,
    "wifi_interface": "wlan1"
  }
}
